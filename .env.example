# ========================================================
# Sales Intelligence - Docker & Server Sozlamalari
# ========================================================

# Tashqi Portlar
FRONTEND_PORT=80
BACKEND_PORT=5156
POSTGRES_PORT=5432

# PostgreSQL Ma'lumotlar Bazasi Sozlamalari
POSTGRES_DB=Sales_Intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongPasswordHere_1234

# Gmail / SMTP Email Xizmati Sozlamalari
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Sales Intelligence Xavfsizlik
SMTP_ENABLE_SSL=true
